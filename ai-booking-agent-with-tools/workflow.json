{
  "name": "AI Booking Agent With Tools",
  "nodes": [
    {
      "id": "c1",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "webhookId": "b5b337c3-0b65-436b-ac48-795336595ef2",
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "initialMessages": "Hi! I can book you a free automation audit call. What day works for you?",
        "options": {
          "title": "Book a free audit",
          "subtitle": "Selwyn Builds booking assistant"
        }
      }
    },
    {
      "id": "c2",
      "name": "Booking agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        300,
        300
      ],
      "parameters": {
        "options": {
          "systemMessage": "=You are the booking assistant for Selwyn Builds, a small automation agency.\nYou book free 30 minute automation audit calls.\nCalls can be booked Monday to Friday, 9am to 5pm New York time, on the hour.\nToday is {{ $now.setZone('America/New_York').toFormat('cccc, LLLL d, yyyy') }}.\n\nRules\n1. Before you offer or book any time, use the Check bookings tool to see which slots are taken.\n2. If the time they ask for is taken, offer the closest free time on the same day.\n3. You need their name and email before booking. Ask for anything missing.\n4. Book with the Book a call tool, then confirm the day, date and time in one short message.\nKeep every reply short and friendly."
        }
      }
    },
    {
      "id": "c3",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        120,
        540
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "options": {
          "temperature": 0.2
        }
      }
    },
    {
      "id": "c4",
