      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Name: {{ $json.name }}\nBusiness: {{ $json.business_type }}\nLeads per month: {{ $json.leads_per_month }}\nNeed: {{ $json.need }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You qualify leads for a small automation agency. Hot means a real business with a clear problem and at least 30 leads a month. Warm means the need is vague. Cold means no clear need. Then write a reply, two sentences max, that mentions their exact problem. Hot leads get invited to a free audit call."
        }
      },
      "webhookId": null
    },
    {
